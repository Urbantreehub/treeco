# Copy this file to .env and fill in your values
# Never commit .env to git

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Optional: error reporting ────────────────────────────────────────────────
# Sentry only initialises when a DSN is set, so leaving these blank keeps dev,
# demo, and CI completely offline (no error reporting).
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENV=production
# VITE_SENTRY_RELEASE=
# VITE_SENTRY_TRACES_RATE=0.1

# ── Optional: e2e ────────────────────────────────────────────────────────────
# Force the "empty tenant" state in a demo build (no seeded jobs/clients).
# The Playwright suite toggles this at runtime per project; you rarely set it here.
# VITE_DEMO_EMPTY=true
