{
  "name": "treeco",
  "buildCommand": "cd frontend && npm install --legacy-peer-deps && npm run build && node ../scripts/build-band.js",
  "outputDirectory": "frontend/dist",
  "installCommand": "echo skip",
  "framework": null,
  "rewrites": [
    {
      "source": "/band",
      "destination": "/band/index.html"
    },
    {
      "source": "/band/",
      "destination": "/band/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
